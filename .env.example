# Copy this file to `.env` on the server (never commit the real .env) and
# fill in real values. docker-compose.yml loads it for the `app` and `db`
# services. See src/main/resources/application.yml for how each is consumed.

# --- Database (used by both the db and app services) ---
DATABASE_NAME=africa_data_solutions
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
DATABASE_POOL_SIZE=10

# --- App / server ---
APP_NAME=Africa Data Solutions
# Public URL the app is reachable at (used to build links, e.g. funding callback).
APP_URL=https://api.africadatasolutions.org
# Comma-separated list of allowed CORS origins for the frontend(s).
FRONTEND_ORIGINS=https://africadatasolutions.org,https://www.africadatasolutions.org
FORWARD_HEADERS_STRATEGY=native
# Set 1+ if the app sits behind Caddy/nginx (it does here) so client IPs resolve correctly.
TRUSTED_PROXIES=1
API_DOCS_ENABLED=true
LOG_LEVEL=INFO

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-long-random-value
JWT_ISSUER=africa-data-solutions
JWT_AUDIENCE=ads-mobile
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# --- Wallet / risk limits ---
WALLET_DAILY_DEBIT_CAP=500000
WALLET_PER_TX_MAX=200000
WALLET_STRICT_LOCKING=true
PIN_MAX_FAILED_ATTEMPTS=5
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- Billstack (legacy virtual accounts / funding — kept only so already-
# issued account numbers keep crediting; new accounts use PaymentPoint) ---
BILLSTACK_API_KEY=
BILLSTACK_SECRET_KEY=
BILLSTACK_BASE_URL=https://api.billstack.co/v2/thirdparty
BILLSTACK_WEBHOOK_SECRET=
# Comma-separated IP allowlist for the webhook endpoint; leave blank to allow any.
BILLSTACK_WEBHOOK_IPS=

# --- PaymentPoint (virtual accounts / funding — current provider for new accounts) ---
# PAYMENTPOINT_API_SECRET doubles as the webhook HMAC-SHA256 key — PaymentPoint
# issues one secret key, not a separate one for webhooks.
PAYMENTPOINT_API_KEY=
PAYMENTPOINT_API_SECRET=
PAYMENTPOINT_BUSINESS_ID=
PAYMENTPOINT_BASE_URL=https://api.paymentpoint.co

# --- SME Plug (data bundles) ---
SME_PLUG_API_KEY=
SME_PLUG_BASE_URL=https://smeplug.ng/api/v1

# --- VTPass (airtime/bills) ---
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_BASE_URL=https://vtpass.com/api

# --- Firebase Cloud Messaging (push notifications, optional) ---
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# --- Email (Gmail SMTP, optional — emails just log a warning and no-op if unset) ---
# Use a Gmail App Password, not your normal password: myaccount.google.com/apppasswords
# (requires 2-Step Verification to be enabled on the account).
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
# Defaults to GMAIL_USERNAME if left blank; Gmail generally requires the From
# address to match the authenticated account (or a verified alias of it).
EMAIL_FROM=

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# --- GHCR image (used by docker-compose.yml on the server) ---
GHCR_OWNER=your-github-username-or-org
GHCR_IMAGE=africa-data-solutions
IMAGE_TAG=latest

# --- Caddy ---
DOMAIN=api.africadatasolutions.org
